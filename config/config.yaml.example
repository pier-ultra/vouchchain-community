# VouchChain 配置模板 —— 复制为 config.yaml 并按环境填写（config.yaml 已 gitignore，严禁提交真实凭据）
server:
  address: ":8000"
  indexFiles: ["index.html"]
  openapi:
    path: "/swagger"

database:
  default:
    # 默认 SQLite（零依赖零配置，适合单机自托管 / 快速体验）：
    type: "sqlite"
    link: "sqlite::@file(./data/vouchchain.db)"
    # 换 PostgreSQL（推荐生产 / 多实例 / 向量检索）：改 type 为 pgsql 并填连接串，例如：
    # type: "pgsql"
    # link: "pgsql:youruser:yourpassword@tcp(127.0.0.1:5432)/vouchchain"
    # charset: "utf8"
    # 换 MySQL（含 TiDB / OceanBase / GreatSQL 等 MySQL 兼容国产库）：type 为 mysql，例如：
    # type: "mysql"
    # link: "mysql:youruser:yourpassword@tcp(127.0.0.1:3306)/vouchchain?charset=utf8mb4&parseTime=true&loc=Local"
    # charset: "utf8mb4"

app:
  # dev 态：跳过验签、注入 dev 用户，可用 X-User-Role 模拟角色。
  # 生产/交付：设置环境变量 APP_DEV_MODE=false 切 SSO 态（需 CASDOOR_CERTIFICATE 或 CASDOOR_CERT_FILE）。
  devMode: true
  casdoor:
    endpoint: ""
    clientId: ""
    clientSecret: ""
    certificate: ""   # x509 证书/公钥 PEM（Casdoor 应用 Cert 页复制）；也可走环境变量
    orgName: ""
    appName: ""
    audience: ""
    issuer: ""
  # SCIM 2.0 身份同步：IdP 推用户/组到 /scim/v2，用独立 Bearer token（不复用用户 JWT）。
  # 只在部署时通过环境变量 SCIM_TOKEN 设置；此文件与库中都不存明文。未设置时 /scim/v2/* 一律 503。
  scim:
    token: ""
  # Eino 条款审查接入的 OpenAI 兼容端点；密钥走环境变量 AGNES_API_KEY，不落库/不落文件
  eino:
    baseUrl: "https://api.agnes-ai.cn/v1"
    model: "agnes-3.0-flash"

# 短 TTL 缓存驱动：memory（默认，进程内，零外部依赖）/ kvrocks（多实例共享，需配下方 redis 节点指向 Kvrocks）
cache:
  driver: "memory"

# 仅 cache.driver=kvrocks 时需要：GoFrame gredis 节点，指向 Apache Kvrocks（Redis 协议完全兼容，也可连标准 Redis）
redis:
  default:
    address: "127.0.0.1:6666"
    db: 0
